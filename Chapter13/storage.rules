rules_version = '2';

// Minimum rules for the Chapter 13 Cloud Storage recipe.
//
// Replace the console's generated test-mode rules with these before publishing.
// They require a signed-in user for every upload and download.
//
// Deploy with:  firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    // Any signed-in user may read and write. Unauthenticated requests are
    // denied, because request.auth is null when nobody is signed in.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
